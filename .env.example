# Скопируйте в .env рядом с docker-compose.yml и заполните значениями.
# Прежние значения лежали прямо в коде и уже попали в git-историю,
# поэтому их нужно перевыпустить, а не просто перенести сюда.

# Django. Смена ключа разлогинивает админку и делает невалидными JWT
# (/auth/otp, /auth/verify, /auth/refresh). Основной поток auth-token не затрагивается.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=mypaprika.net,www.mypaprika.net,web,localhost,127.0.0.1
LOG_LEVEL=INFO

# Push-уведомления (FCM legacy). Прежний ключ скомпрометирован - нужен новый.
FCM_SERVER_KEY=

# SMS-шлюз tcell (нужен при SMS_ENABLED=true)
SMS_LOGIN=
SMS_PASSWORD=

# SMS через Kannel (authentification/kannelSMS.py)
KANNEL_USER=
KANNEL_PASSWORD=

# Тестовый номер для проверки приложения в сторах: пока переменные пустые,
# обхода проверки OTP нет вообще.
DEV_TEST_MSISDN=
DEV_TEST_TOKEN=

# Отладочный auth-token (раньше был захардкожен в auth_decorators.py).
# В проде оставить пустым.
DEV_AUTH_TOKEN=
DEV_AUTH_MSISDN=
